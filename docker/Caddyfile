# TourPilot edge proxy with automatic HTTPS.
#
# - Apex + www → production web container.
# - dev.srilankatourpilot.com → isolated DEV stack on the host (:8081).
# - Any other host → On-Demand TLS (agency custom domains), gated by ask.

{
	email {$CADDY_EMAIL}
	on_demand_tls {
		ask http://api:4000/api/tls/check
	}
}

# Production platform domain → PROD web.
{$PLATFORM_DOMAIN}, www.{$PLATFORM_DOMAIN} {
	encode zstd gzip
	header X-TourPilot-Env production
	reverse_proxy web:80
}

# DEV subdomain → isolated stack (COMPOSE_PROJECT_NAME=tourpilot-dev).
# Hostnames are listed explicitly so a missing PLATFORM_DOMAIN env can never
# cause this traffic to fall through to the catch-all (which is production).
dev.srilankatourpilot.com, {$DEV_DOMAIN} {
	encode zstd gzip
	header X-TourPilot-Env development
	reverse_proxy {$DEV_UPSTREAM}
}

# Agency custom domains — On-Demand TLS, gated by the ask endpoint.
# Do NOT put platform hosts here; they must match the blocks above.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header X-TourPilot-Env production-ondemand
	reverse_proxy web:80
}

# Redirect plain HTTP to HTTPS for any host.
http:// {
	redir https://{host}{uri} permanent
}
