# DEV environment — copy to .env inside the dev deploy folder (e.g. /var/www/tourpilot-dev)
#   cp .env.development.example .env
# This stack is fully isolated from production (separate DB, uploads, ports).
# Always run the dev stack with:  COMPOSE_PROJECT_NAME=tourpilot-dev docker compose ...

# —— Public URL (no trailing slash) ——
WEB_APP_URL=https://dev.srilankatourpilot.com
# Host nginx owns 80/443; dev Docker web listens on 8081 (prod uses 8080)
HTTP_PORT=8081

# —— MySQL (separate credentials from production) ——
# MYSQL_USER must be a non-root app user (never "root").
MYSQL_ROOT_PASSWORD=change-me-dev-root-password-long
MYSQL_DATABASE=tourpilot
MYSQL_USER=tourpilot
MYSQL_PASSWORD=change-me-dev-db-password-long
# Localhost-only publish for SSH tunnels. Use 3308 so it does NOT clash with
# production MySQL on 3307.
MYSQL_HOST_PORT=3308

# —— Auth (generate with: openssl rand -hex 32; use DIFFERENT secrets than prod) ——
JWT_SECRET=change-me-dev-jwt-secret-32chars-min
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-32chars

# —— Email (dev: just log) ——
EMAIL_MODE=log
EMAIL_FROM=TourPilot Dev <noreply@dev.srilankatourpilot.com>

# —— OTP (handy for testing on dev) ——
# Show OTP in login UI response:
DEMO_OTP_IN_RESPONSE=true
# Print OTP in API container logs:
LOG_OTP_TO_CONSOLE=true
# Never enable in real production:
DEV_BYPASS_OTP=false

# —— Live display FX (optional) ——
# Cache TTL for GET /api/fx/rates (ms). Default 6 hours.
# FX_CACHE_TTL_MS=21600000

# —— PayHere (required for invoices, packages, and wallet top-up) ——
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true

# —— AI chatbot / trip planner (OpenAI-compatible) ——
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Gemini example:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.6-flash
# Prefer gemini-3.x — gemini-2.0/2.5-flash are often blocked for new API keys.

# —— Image tags are exported by the deploy-dev workflow (dev-<sha>) ——
# API_IMAGE=ghcr.io/YOUR_GITHUB_USER/tourpilot-api:dev
# WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/tourpilot-web:dev

# Auto-apply Prisma schema when the API container starts.
PRISMA_ACCEPT_DATA_LOSS=true

# Optional: Google Analytics (web build-time). Loads only after cookie Accept.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

INQUIRY_EXPIRY_DAYS=7

# —— Optional (only needed if you run custom-domain code paths on DEV) ——
# Leave empty on DEV unless you are testing agency custom domains against this stack.
PLATFORM_DOMAIN=dev.srilankatourpilot.com
PLATFORM_DOMAINS=dev.srilankatourpilot.com
# CUSTOM_DOMAIN_A_TARGET=
# CUSTOM_DOMAIN_CNAME_TARGET=

# —— CORS (headless local starters) ——
# HEADLESS_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# CORS_STRICT=false

# —— CORS (headless local starters) ——
# HEADLESS_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# CORS_STRICT=false
