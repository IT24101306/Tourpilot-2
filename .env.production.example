# Copy to .env on the server (never commit real secrets)
#   cp .env.production.example .env

# —— Public URL (no trailing slash) ——
WEB_APP_URL=https://srilankatourpilot.com
# When using the Caddy edge (--profile edge), Caddy owns 80/443 and the web
# container listens on 8080. (Legacy host-nginx setup also uses 8080.)
HTTP_PORT=8080

# —— Edge / custom domains (Caddy On-Demand TLS) ——
# Platform primary domain (apex; www is handled automatically).
PLATFORM_DOMAIN=srilankatourpilot.com
# Comma-separated hosts owned by the platform (never treated as agency domains).
# Include the DEV subdomain so Caddy's TLS ask endpoint allows it.
PLATFORM_DOMAINS=srilankatourpilot.com,dev.srilankatourpilot.com
# Email for Let's Encrypt account (used by Caddy).
CADDY_EMAIL=admin@srilankatourpilot.com
# Set to true by scripts/wire-caddy.sh so GitHub deploy.yml keeps --profile edge.
USE_CADDY_EDGE=true
# DEV hostname served by production Caddy → isolated stack on :8081
DEV_DOMAIN=dev.srilankatourpilot.com
# How production Caddy reaches the DEV stack (Path B).
DEV_UPSTREAM=host.docker.internal:8081
# Public IPv4 of this server; agencies point an A record here for custom domains.
CUSTOM_DOMAIN_A_TARGET=200.97.168.95
# Optional CNAME target for www/subdomain custom domains.
# CUSTOM_DOMAIN_CNAME_TARGET=srilankatourpilot.com

# —— CORS for platform SPA + headless custom websites ——
# When CORS_ORIGINS or HEADLESS_CORS_ORIGINS is set (or CORS_STRICT=true),
# only listed origins may call the API from a browser. WEB_APP_URL and
# localhost:5173 are always included when an allowlist is active.
# CORS_ORIGINS=https://srilankatourpilot.com,https://dev.srilankatourpilot.com
# HEADLESS_CORS_ORIGINS=https://www.client-agency.com,https://client-agency.com
# CORS_STRICT=false

# —— MySQL ——
# MYSQL_USER must be a non-root app user (never "root").
MYSQL_ROOT_PASSWORD=change-me-root-password-long
MYSQL_DATABASE=tourpilot
MYSQL_USER=tourpilot
MYSQL_PASSWORD=change-me-db-password-long
# Localhost-only publish for SSH tunnels (do not expose publicly).
# Use 3307 if the VPS already has MySQL on 3306:
MYSQL_HOST_PORT=3307

# —— Auth (generate with: openssl rand -hex 32) ——
JWT_SECRET=change-me-jwt-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars

# —— Email (log | webhook | smtp) ——
# Use the cPanel server hostname from Reverse DNS / Email Routing (not mail.domain.com
# if that host times out). Example: server34.lakgate.com
EMAIL_MODE=smtp
EMAIL_FROM=TourPilot <hello@srilankatourpilot.com>
SMTP_HOST=server34.lakgate.com
SMTP_PORT=587
SMTP_USER=hello@srilankatourpilot.com
SMTP_PASS=your-mailbox-password-here
SMTP_SECURE=false
# Alt SSL: SMTP_PORT=465 and SMTP_SECURE=true
# EMAIL_WEBHOOK_URL=

# —— OTP (no SMS yet: use one of these for staging) ——
# Show OTP in login UI response:
DEMO_OTP_IN_RESPONSE=true
# Print OTP in API container logs (`docker compose ... logs -f api`):
LOG_OTP_TO_CONSOLE=true
# Never enable in real production:
DEV_BYPASS_OTP=false

# —— PayHere (optional; without these, tourists use demo checkout) ——
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true

# —— AI chatbot / trip planner (OpenAI-compatible) ——
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Gemini example:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash

# —— Optional image tags from CI ——
# API_IMAGE=ghcr.io/YOUR_GITHUB_USER/tourpilot-api:latest
# WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/tourpilot-web:latest

# Auto-apply Prisma schema when the API container starts (CI/CD deploys).
# Set false only if you want deploys to fail instead of dropping columns.
PRISMA_ACCEPT_DATA_LOSS=true

# Optional: Google Analytics (web build-time). Only loads after cookie Accept.
# Rebuild the web image after setting this (VITE_* is baked at build).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Live display FX cache TTL for GET /api/fx/rates (ms). Default 6 hours.
# FX_CACHE_TTL_MS=21600000

INQUIRY_EXPIRY_DAYS=14
