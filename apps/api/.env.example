DATABASE_URL="mysql://tourpilot:tourpilot@localhost:3306/tourpilot"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=4000
NODE_ENV=development
DEMO_OTP_IN_RESPONSE=true
# Dev only: always use OTP 000000 (no SMS). Requires NODE_ENV=development
DEV_BYPASS_OTP=true
DEV_BYPASS_OTP_CODE=000000
# Print OTP in API terminal (default on when NODE_ENV is not production)
LOG_OTP_TO_CONSOLE=true
