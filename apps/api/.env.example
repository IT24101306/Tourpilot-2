# Server
PORT=4000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://tourpilot:tourpilot@localhost:3306/tourpilot"

# Auth (change in production)
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret

# OTP — keep in dev mode (no SMS provider)
DEV_BYPASS_OTP=true
DEV_BYPASS_OTP_CODE=000000
DEMO_OTP_IN_RESPONSE=true
LOG_OTP_TO_CONSOLE=true

# Email — log (default) | webhook | smtp
EMAIL_MODE=log
EMAIL_FROM="TourPilot <noreply@tourpilot.local>"
# Webhook: POST JSON { to, subject, text, html }
# EMAIL_WEBHOOK_URL=https://your-email-service.example/send
# SMTP (when EMAIL_MODE=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Public web URL (used in email links)
WEB_APP_URL=http://localhost:5173

# Inquiry auto-expiry (days without activity on open statuses)
INQUIRY_EXPIRY_DAYS=14
INQUIRY_EXPIRY_INTERVAL_MS=3600000
