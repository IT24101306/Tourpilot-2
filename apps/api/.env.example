# Server
PORT=4000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://tourpilot:tourpilot@localhost:3306/tourpilot"

# Auth (change in production)
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret

# OTP — keep in dev mode (no SMS provider)
DEV_BYPASS_OTP=true
DEV_BYPASS_OTP_CODE=000000
DEMO_OTP_IN_RESPONSE=true
LOG_OTP_TO_CONSOLE=true

# Email — log (default) | webhook | smtp
EMAIL_MODE=log
EMAIL_FROM="TourPilot <noreply@tourpilot.local>"
# Webhook: POST JSON { to, subject, text, html }
# EMAIL_WEBHOOK_URL=https://your-email-service.example/send
# SMTP (when EMAIL_MODE=smtp)
# Prefer the cPanel server hostname from Reverse DNS (e.g. server34.lakgate.com)
# if mail.yourdomain.com times out on 465/587.
# SMTP_HOST=server34.lakgate.com
# SMTP_PORT=587
# SMTP_USER=hello@yourdomain.com
# SMTP_PASS=
# SMTP_SECURE=false
# Alt SSL: port 465 with SMTP_SECURE=true

# Public web URL (used in email links)
WEB_APP_URL=http://localhost:5173

# Inquiry auto-expiry (days without activity on open statuses)
INQUIRY_EXPIRY_DAYS=7
INQUIRY_EXPIRY_INTERVAL_MS=3600000

# AI (OpenAI-compatible). Required for Trip Planner / chatbot — no stub replies without a key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Gemini: set OPENAI_API_KEY to your Gemini key, then:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash
# (TourPilot uses Gemini's native generateContent when BASE_URL is Google — more reliable than the OpenAI shim.)
# Alternatives: gemini-flash-latest, gemini-2.5-flash, gemini-3.6-flash — pick one your key can list.
