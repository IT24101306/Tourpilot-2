}

enum InquiryType {
  READY_MADE
  CUSTOM
}

enum InquiryResponseKind {
  MESSAGE
  READY_MADE
  CUSTOM_ITINERARY
}

enum InquiryProposalItemKind {
  READY_MADE
  CUSTOM
}

enum InquiryMessageKind {
  TOURIST
