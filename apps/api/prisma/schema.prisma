generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TOURIST
  AGENCY
  INFLUENCER
  DRIVER
  ADMIN
}

enum AgencyStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum CustomDomainStatus {
  NONE
  PENDING
  ACTIVE
  ERROR
}

enum InquiryStatus {
  NEW
  AGENCY_REVIEWING
  ITINERARY_DRAFT
  SENT_TO_TOURIST
  TOURIST_VIEWED
  REVISION_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InquiryType {
  READY_MADE
  CUSTOM
}

enum InquiryResponseKind {
  MESSAGE
  READY_MADE
  CUSTOM_ITINERARY
}

enum InquiryProposalItemKind {
  READY_MADE
  CUSTOM
}

enum InquiryMessageKind {
  TOURIST
  AGENCY
  ADMIN
  INFLUENCER
}

enum EntityType {
  HOTEL
  VIEWPOINT
  ACTIVITY
  RESTAURANT
  OTHER
}

enum LineItemKind {
  REQUIRED
  OPTIONAL
  UPGRADE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum VoucherDiscountType {
  FIXED_LKR
  PERCENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InfluencerCommissionRequestStatus {
  PENDING
  NEGOTIATING
  APPROVED
  REJECTED
}

enum CommissionNegotiationActor {
  INFLUENCER
  AGENCY
}

enum CommissionNegotiationAction {
  REQUEST
  NEGOTIATE
  AGREE
  REJECT
}

enum WalletTxnType {
  LOGIN_FEE
  TOPUP
  COMMISSION
  REFUND
  ADJUSTMENT
}

enum TourKind {
  READY_MADE
  CUSTOM
}

model User {
  id                   String                @id @default(cuid()) @db.VarChar(25)
  phone                String                @unique @db.VarChar(20)
  name                 String
  role                 UserRole              @default(TOURIST)
  email                String?
  avatarUrl            String?               @db.Text
  district             String?
  country              String?               @default("LK")
  walletBalance        Decimal               @default(0) @db.Decimal(12, 2)
  /** When set, overrides platform role login fee. Null = use role default. */
  loginFeeLkr          Decimal?              @db.Decimal(12, 2)
  passwordHash         String?               @db.VarChar(64)
  isActive             Boolean               @default(true)
  /** Last authenticated API activity — used for optional inactivity session timeout. */
  lastActiveAt         DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  agency               Agency?
  agencyStaff          AgencyStaff[]
  touristProfile       TouristProfile?
  influencerProfile    InfluencerProfile?
  driverProfile        DriverProfile?
  inquiries            Inquiry[]             @relation("TouristInquiries")
  offerRegistrations   OfferRegistration[]
  savedTours           SavedTour[]
  savedTripPlans       SavedTripPlan[]
  walletLedger         WalletLedger[]
  refreshTokens        RefreshToken[]
  referralAttributions ReferralAttribution[]
  agencyDriver              AgencyDriver?
  inquiryMessages           InquiryMessage[]
  authoredInquiryResponses  InquiryResponse[] @relation("InquiryResponseAuthor")
  notifications             Notification[]
}

model Notification {
  id        String    @id @default(cuid()) @db.VarChar(25)
  userId    String    @db.VarChar(25)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String
  body      String    @db.Text
  inquiryId String?   @db.VarChar(25)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model AgencyDriver {
  id          String             @id @default(cuid()) @db.VarChar(25)
  agencyId    String             @db.VarChar(25)
  agency      Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String?            @unique @db.VarChar(25)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  phone       String?
  licenseNo   String?
  vehicle     String?
  status      String             @default("Available")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments DriverAssignment[]

  @@index([agencyId])
}

model DriverAssignment {
  id             String       @id @default(cuid()) @db.VarChar(25)
  agencyDriverId String       @db.VarChar(25)
  agencyDriver   AgencyDriver @relation(fields: [agencyDriverId], references: [id], onDelete: Cascade)
  inquiryId      String?      @db.VarChar(25)
  inquiry        Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  tourId         String?      @db.VarChar(25)
  tour           Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  title          String
  startDate      DateTime
  endDate        DateTime?
  notes          String?      @db.Text
  status         String       @default("Scheduled")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agencyDriverId, startDate])
  @@index([inquiryId])
}

model TouristProfile {
  id               String  @id @default(cuid()) @db.VarChar(25)
  userId           String  @unique @db.VarChar(25)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests        Json?
  mobilityNotes    String? @db.Text
  dietaryNotes     String? @db.Text
  loyaltyPoints    Int     @default(0)
  displayCurrency  String  @default("USD") @db.VarChar(3)
  followedAgencies Json?
}

model InfluencerProfile {
  id                 String                        @id @default(cuid()) @db.VarChar(25)
  userId             String                        @unique @db.VarChar(25)
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String?                       @unique @db.VarChar(191)
  bio                String?                       @db.Text
  socialLinks        Json?
  display            Json?
  codes              ReferralCode[]
  commissions        Commission[]
  commissionRequests InfluencerCommissionRequest[]
  handledInquiries   Inquiry[]                     @relation("InquiryHandlerInfluencer")
}

model DriverProfile {
  id           String  @id @default(cuid()) @db.VarChar(25)
  userId       String  @unique @db.VarChar(25)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo    String?
  vehicle      String?
  status       String  @default("available")
  bio          String? @db.Text
  articles     Json?
  blockedDates Json?
  metadata     Json?
}

model Agency {
  id              String           @id @default(cuid()) @db.VarChar(25)
  ownerId         String           @unique @db.VarChar(25)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  slug            String           @unique @db.VarChar(191)
  tagline         String?          @db.Text
  description     String?          @db.Text
  logoUrl         String?          @db.Text
  coverUrl        String?          @db.Text
  district        String?
  status          AgencyStatus     @default(PENDING)
  avgRating       Decimal          @default(0) @db.Decimal(3, 2)
  reviewCount     Int              @default(0)
  pageConfig      Json?
  gallery         Json?
  contactPhone             String?
  contactEmail             String?
  influencerCommissionPct  Decimal          @default(8) @db.Decimal(5, 2)
  kyc             Json?
  kycSubmittedAt  DateTime?
  rejectionReason String?          @db.Text
  rejectedAt      DateTime?
  /** Product access flags — admin toggles per agency (defaults keep current behavior). */
  featureDriversAndPartners     Boolean @default(true)
  featureSupport                Boolean @default(true)
  featureWalletTopup            Boolean @default(true)
  featureOffers                 Boolean @default(true)
  featureDisplay                Boolean @default(true)
  featureReadyMadeTours         Boolean @default(true)
  featureCustomInquiries        Boolean @default(true)
  featureNegotiationsBookings   Boolean @default(true)
  /** Custom domain (Shopify-style) — off by default, admin enables per agency. */
  featureCustomDomain           Boolean @default(false)
  /** External/headless custom website against TourPilot APIs — off by default. */
  featureExternalStorefront     Boolean @default(false)
  /**
   * When on, agency owner/staff sessions expire after inactivity (platform default
   * or sessionInactivityHours). Re-login charges the login fee again.
   */
  featureSessionInactivityTimeout Boolean @default(false)
  /** Hours of inactivity before forced re-login. Null = use platform default. */
  sessionInactivityHours        Int?
  customDomain           String?             @unique @db.VarChar(255)
  customDomainStatus     CustomDomainStatus  @default(NONE)
  customDomainVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  staff           AgencyStaff[]
  entities        Entity[]
  entityGroups    EntityGroup[]
  tours           Tour[]
  reviews         Review[]
  inquiries       Inquiry[]
  displaySettings DisplaySettings?
  drivers                AgencyDriver[]
  offers                 Offer[]
  influencerCommissionRequests InfluencerCommissionRequest[]
  savedTripPlans               SavedTripPlan[]
}

model AgencyStaff {
  id        String   @id @default(cuid()) @db.VarChar(25)
  agencyId  String   @db.VarChar(25)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())

  @@unique([agencyId, userId])
}

model Entity {
  id          String              @id @default(cuid()) @db.VarChar(25)
  agencyId    String              @db.VarChar(25)
  agency      Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name        String
  type        EntityType
  city        String?
  district    String?
  description String?             @db.Text
  durationMin Int?
  priceHint   Decimal?            @db.Decimal(12, 2)
  contact     String?
  lat         Decimal?            @db.Decimal(10, 7)
  lng         Decimal?            @db.Decimal(10, 7)
  media       Json?
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  groupItems  EntityGroupItem[]
  tourItems   TourDayItem[]
  lineItems   ItineraryLineItem[]
}

model EntityGroup {
  id          String            @id @default(cuid()) @db.VarChar(25)
  agencyId    String            @db.VarChar(25)
  agency      Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       EntityGroupItem[]
  tourItems   TourDayItem[]
}

model EntityGroupItem {
  id        String      @id @default(cuid()) @db.VarChar(25)
  groupId   String      @db.VarChar(25)
  group     EntityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entityId  String      @db.VarChar(25)
  entity    Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)

  @@unique([groupId, entityId])
}

model Tour {
  id               String                @id @default(cuid()) @db.VarChar(25)
  agencyId         String                @db.VarChar(25)
  agency           Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title            String
  slug             String                @db.VarChar(191)
  summary          String?               @db.Text
  description      String?               @db.Text
  days             Int                   @default(1)
  tourKind         TourKind              @default(READY_MADE)
  basePriceLkr              Decimal               @db.Decimal(12, 2)
  influencerCommissionPct   Decimal?              @db.Decimal(5, 2)
  influencerCommissionLkr Decimal               @default(0) @db.Decimal(12, 2)
  seasonTag        String?
  districtTags     Json?
  coverUrl               String?               @db.Text
  media                  Json?
  influencerInstructions String?               @db.Text
  isPublished            Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  tourDays               TourDay[]
  inquiries              Inquiry[]
  inquiryResponses       InquiryResponse[]
  proposalItems          InquiryProposalItem[]
  savedBy                SavedTour[]
  referralCodes          ReferralCode[]
  offerTours             OfferTour[]
  offerRegistrations     OfferRegistration[]
  driverAssignments      DriverAssignment[]
  influencerCommissionRequests InfluencerCommissionRequest[]

  @@unique([agencyId, slug])
}

model InfluencerCommissionRequest {
  id             String                            @id @default(cuid()) @db.VarChar(25)
  influencerId   String                            @db.VarChar(25)
  influencer     InfluencerProfile                 @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  tourId         String                            @db.VarChar(25)
  tour           Tour                              @relation(fields: [tourId], references: [id], onDelete: Cascade)
  agencyId       String                            @db.VarChar(25)
  agency         Agency                            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  requestedPct   Decimal                           @db.Decimal(5, 2)
  currentOfferPct Decimal                          @default(0) @db.Decimal(5, 2)
  message        String                            @db.Text
  status         InfluencerCommissionRequestStatus @default(PENDING)
  pendingActor   CommissionNegotiationActor        @default(AGENCY)
  offerByRole    CommissionNegotiationActor?
  approvedPct    Decimal?                          @db.Decimal(5, 2)
  agencyNote     String?                           @db.Text
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  messages       InfluencerCommissionMessage[]

  @@index([agencyId, status])
  @@index([influencerId, tourId])
}

model InfluencerCommissionMessage {
  id          String                      @id @default(cuid()) @db.VarChar(25)
  requestId   String                      @db.VarChar(25)
  request     InfluencerCommissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorRole  CommissionNegotiationActor
  authorId    String                      @db.VarChar(25)
  action      CommissionNegotiationAction
  proposedPct Decimal?                    @db.Decimal(5, 2)
  body        String                      @db.Text
  createdAt   DateTime                    @default(now())

  @@index([requestId, createdAt])
}

model TourDay {
  id                 String        @id @default(cuid()) @db.VarChar(25)
  tourId             String        @db.VarChar(25)
  tour               Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  dayNumber          Int
  title              String?
  transportVehicleId String?       @db.VarChar(40)
  transportLabel     String?
  transportRateLkr         Decimal?      @db.Decimal(12, 2)
  transportSellingPriceLkr Decimal?      @db.Decimal(12, 2)
  items                    TourDayItem[]

  @@unique([tourId, dayNumber])
}

model TourDayItem {
  id            String       @id @default(cuid()) @db.VarChar(25)
  tourDayId     String       @db.VarChar(25)
  tourDay       TourDay      @relation(fields: [tourDayId], references: [id], onDelete: Cascade)
  entityId      String?      @db.VarChar(25)
  entity        Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  groupId       String?      @db.VarChar(25)
  group         EntityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  kind          LineItemKind @default(REQUIRED)
  label         String?
  priceLkr         Decimal?     @db.Decimal(12, 2)
  sellingPriceLkr  Decimal?     @db.Decimal(12, 2)
  scheduledTime    String?      @db.VarChar(8)
  sortOrder     Int          @default(0)
  notes         String?      @db.Text
}

model Inquiry {
  id                  String             @id @default(cuid()) @db.VarChar(25)
  touristId           String             @db.VarChar(25)
  tourist             User               @relation("TouristInquiries", fields: [touristId], references: [id])
  agencyId            String             @db.VarChar(25)
  agency              Agency             @relation(fields: [agencyId], references: [id])
  tourId              String?            @db.VarChar(25)
  tour                Tour?              @relation(fields: [tourId], references: [id], onDelete: SetNull)
  type                InquiryType
  status              InquiryStatus      @default(NEW)
  pax                 Int                @default(2)
  startDate           DateTime?
  endDate             DateTime?
  budgetBand          String?
  interests           Json?
  message             String?            @db.Text
  referralCodeId      String?            @db.VarChar(25)
  referralCode        ReferralCode?      @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  /// When set, influencer fronts the chat (share-as-mine); agency still fulfills.
  handlerInfluencerId String?            @db.VarChar(25)
  handlerInfluencer   InfluencerProfile? @relation("InquiryHandlerInfluencer", fields: [handlerInfluencerId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  itineraries         Itinerary[]
  responses           InquiryResponse[]
  proposal            InquiryProposal?
  messages            InquiryMessage[]
  statusHistory       InquiryStatusLog[]
  commission          Commission?
  driverAssignments   DriverAssignment[]
  invoice             Invoice?

  @@index([handlerInfluencerId])
}

model InquiryMessage {
  id        String             @id @default(cuid()) @db.VarChar(25)
  inquiryId String             @db.VarChar(25)
  inquiry   Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String             @db.VarChar(25)
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      InquiryMessageKind
  body      String             @db.Text
  action    String?            @db.VarChar(40)
  createdAt DateTime           @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryProposal {
  id        String                @id @default(cuid()) @db.VarChar(25)
  inquiryId String                @unique @db.VarChar(25)
  inquiry   Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  message   String                @db.Text
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     InquiryProposalItem[]
}

model InquiryProposalItem {
  id          String                  @id @default(cuid()) @db.VarChar(25)
  proposalId  String                  @db.VarChar(25)
  proposal    InquiryProposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  kind        InquiryProposalItemKind
  tourId      String?                 @db.VarChar(25)
  tour        Tour?                   @relation(fields: [tourId], references: [id], onDelete: SetNull)
  itineraryId String?                 @unique @db.VarChar(25)
  itinerary   Itinerary?              @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  sortOrder   Int                     @default(0)

  @@index([proposalId])
}

model InquiryStatusLog {
  id        String        @id @default(cuid()) @db.VarChar(25)
  inquiryId String        @db.VarChar(25)
  inquiry   Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status    InquiryStatus
  note      String?       @db.Text
  actorId   String?       @db.VarChar(25)
  createdAt DateTime      @default(now())
}

model Itinerary {
  id            String               @id @default(cuid()) @db.VarChar(25)
  inquiryId     String               @db.VarChar(25)
  inquiry       Inquiry              @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  version       Int                  @default(1)
  title         String?
  notes         String?              @db.Text
  baseTotal     Decimal              @default(0) @db.Decimal(12, 2)
  optionalTotal Decimal              @default(0) @db.Decimal(12, 2)
  grandMax      Decimal              @default(0) @db.Decimal(12, 2)
  isSent        Boolean              @default(false)
  sentAt        DateTime?
  shareToken    String?              @unique @db.VarChar(64)
  createdAt     DateTime             @default(now())
  days          ItineraryDay[]
  lineItems     ItineraryLineItem[]
  response      InquiryResponse?
  proposalItem  InquiryProposalItem?
}

model InquiryResponse {
  id          String              @id @default(cuid()) @db.VarChar(25)
  inquiryId   String              @db.VarChar(25)
  inquiry     Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId    String              @db.VarChar(25)
  author      User                @relation("InquiryResponseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  message     String              @db.Text
  kind        InquiryResponseKind
  tourId      String?             @db.VarChar(25)
  tour        Tour?               @relation(fields: [tourId], references: [id], onDelete: SetNull)
  itineraryId String?             @unique @db.VarChar(25)
  itinerary   Itinerary?          @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([inquiryId])
}

model ItineraryDay {
  id          String              @id @default(cuid()) @db.VarChar(25)
  itineraryId String              @db.VarChar(25)
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String?
  lineItems   ItineraryLineItem[]

  @@unique([itineraryId, dayNumber])
}

model ItineraryLineItem {
  id             String        @id @default(cuid()) @db.VarChar(25)
  itineraryId    String        @db.VarChar(25)
  itinerary      Itinerary     @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayId          String?       @db.VarChar(25)
  day            ItineraryDay? @relation(fields: [dayId], references: [id], onDelete: Cascade)
  entityId       String?       @db.VarChar(25)
  entity         Entity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  label          String
  kind           LineItemKind  @default(REQUIRED)
  priceLkr       Decimal?      @db.Decimal(12, 2)
  priceOnRequest Boolean       @default(false)
  sortOrder      Int           @default(0)
  notes          String?       @db.Text
}

model Review {
  id         String   @id @default(cuid()) @db.VarChar(25)
  agencyId   String   @db.VarChar(25)
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  body       String?  @db.Text
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Offer {
  id              String              @id @default(cuid()) @db.VarChar(25)
  agencyId        String?             @db.VarChar(25)
  agency          Agency?             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title           String
  description     String?             @db.Text
  imageUrl        String?             @db.Text
  rewardText      String
  offerMonth      String?             @db.VarChar(7)
  rewardTiers     Json?
  registrationCap Int
  validFrom       DateTime
  validUntil      DateTime
  tourPriceLkr    Decimal             @db.Decimal(12, 2)
  discountedLkr   Decimal?            @db.Decimal(12, 2)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  registrations   OfferRegistration[]
  tours           OfferTour[]

  @@index([agencyId])
}

model OfferTour {
  id      String @id @default(cuid()) @db.VarChar(25)
  offerId String @db.VarChar(25)
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tourId  String @db.VarChar(25)
  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([offerId, tourId])
}

model OfferRegistration {
  id              String   @id @default(cuid()) @db.VarChar(25)
  offerId         String   @db.VarChar(25)
  offer           Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId          String   @db.VarChar(25)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId          String?  @db.VarChar(25)
  tour            Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  screenshotUrl   String   @db.Text
  message         String   @db.Text
  termsAcceptedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([offerId, userId])
}

model ReferralCode {
  id            String                @id @default(cuid()) @db.VarChar(25)
  influencerId  String                @db.VarChar(25)
  influencer    InfluencerProfile     @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  code          String                @unique @db.VarChar(32)
  tourId        String?               @db.VarChar(25)
  tour          Tour?                 @relation(fields: [tourId], references: [id], onDelete: SetNull)
  commissionPct Decimal               @default(5) @db.Decimal(5, 2)
  clickCount    Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  inquiries     Inquiry[]
  attributions  ReferralAttribution[]
  commissions   Commission[]
}

model ReferralAttribution {
  id             String       @id @default(cuid()) @db.VarChar(25)
  referralCodeId String       @db.VarChar(25)
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  userId         String?      @db.VarChar(25)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())
}

model Commission {
  id             String            @id @default(cuid()) @db.VarChar(25)
  referralCodeId String            @db.VarChar(25)
  referralCode   ReferralCode      @relation(fields: [referralCodeId], references: [id])
  influencerId   String            @db.VarChar(25)
  influencer     InfluencerProfile @relation(fields: [influencerId], references: [id])
  inquiryId      String            @unique @db.VarChar(25)
  inquiry        Inquiry           @relation(fields: [inquiryId], references: [id])
  amountLkr      Decimal           @db.Decimal(12, 2)
  status         CommissionStatus  @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CmsPage {
  id          String   @id @default(cuid()) @db.VarChar(25)
  slug        String   @unique @db.VarChar(191)
  title       String
  blocks      Json
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model DisplaySettings {
  id        String   @id @default(cuid()) @db.VarChar(25)
  agencyId  String   @unique @db.VarChar(25)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sections  Json
  theme     Json?
  updatedAt DateTime @updatedAt
}

model SavedTour {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId    String   @db.VarChar(25)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tourId])
}

model SavedTripPlan {
  id           String   @id @default(cuid()) @db.VarChar(25)
  userId       String   @db.VarChar(25)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId     String   @db.VarChar(25)
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title        String
  plan         Json
  estimatedLkr Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

model WalletLedger {
  id           String        @id @default(cuid()) @db.VarChar(25)
  userId       String        @db.VarChar(25)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTxnType
  amountLkr    Decimal       @db.Decimal(12, 2)
  balanceAfter Decimal       @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime      @default(now())
}

model OtpChallenge {
  id        String   @id @default(cuid()) @db.VarChar(25)
  phone     String   @db.VarChar(20)
  otpHash   String   @db.VarChar(64)
  purpose   String   @db.VarChar(32)
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model RefreshToken {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/** Singleton platform config (id = "default"). */
model PlatformSettings {
  id                 String   @id @db.VarChar(32)
  loginFees          Json
  inquiryExpiryDays  Int      @default(14)
  webAppUrl          String?  @db.VarChar(255)
  emailFrom          String?  @db.VarChar(255)
  walletTopupMinLkr  Int      @default(100)
  walletTopupMaxLkr  Int?
  /** Default idle hours before agencies with the inactivity package must re-login. */
  sessionInactivityHours Int  @default(3)
  /** Optional subject/body overrides keyed by template id. */
  emailTemplates     Json?
  updatedAt          DateTime @updatedAt
}

/** Admin-created discount codes redeemable on tourist invoices. */
model Voucher {
  id              String              @id @default(cuid()) @db.VarChar(25)
  code            String              @unique @db.VarChar(64)
  description     String?             @db.Text
  discountType    VoucherDiscountType
  discountValue   Decimal             @db.Decimal(12, 2)
  maxUses         Int?
  usedCount       Int                 @default(0)
  minInvoiceLkr   Decimal?            @db.Decimal(12, 2)
  maxDiscountLkr  Decimal?            @db.Decimal(12, 2)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean             @default(true)
  createdById     String?             @db.VarChar(25)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  redemptions     VoucherRedemption[]
  invoices        Invoice[]
}

model Invoice {
  id                  String            @id @default(cuid()) @db.VarChar(25)
  inquiryId           String            @unique @db.VarChar(25)
  inquiry             Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  invoiceNumber       String            @unique @db.VarChar(40)
  status              InvoiceStatus     @default(DRAFT)
  subtotalLkr         Decimal           @db.Decimal(12, 2)
  voucherId           String?           @db.VarChar(25)
  voucher             Voucher?          @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode         String?           @db.VarChar(64)
  voucherDiscountLkr  Decimal           @default(0) @db.Decimal(12, 2)
  totalLkr            Decimal           @db.Decimal(12, 2)
  currency            String            @default("LKR") @db.VarChar(8)
  notes               String?           @db.Text
  sentAt              DateTime?
  paidAt              DateTime?
  createdById         String            @db.VarChar(25)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lineItems           InvoiceLineItem[]
  redemptions         VoucherRedemption[]
  payments            Payment[]

  @@index([status, createdAt])
}

model InvoiceLineItem {
  id            String  @id @default(cuid()) @db.VarChar(25)
  invoiceId     String  @db.VarChar(25)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label         String  @db.VarChar(255)
  quantity      Int     @default(1)
  unitPriceLkr  Decimal @db.Decimal(12, 2)
  amountLkr     Decimal @db.Decimal(12, 2)
  sortOrder     Int     @default(0)

  @@index([invoiceId])
}

model VoucherRedemption {
  id           String   @id @default(cuid()) @db.VarChar(25)
  voucherId    String   @db.VarChar(25)
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  invoiceId    String   @db.VarChar(25)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  touristId    String   @db.VarChar(25)
  discountLkr  Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([invoiceId])
  @@index([voucherId])
  @@index([touristId])
}

model Payment {
  id            String        @id @default(cuid()) @db.VarChar(25)
  invoiceId     String        @db.VarChar(25)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountLkr     Decimal       @db.Decimal(12, 2)
  currency      String        @default("LKR") @db.VarChar(8)
  status        PaymentStatus @default(PENDING)
  provider      String        @default("payhere") @db.VarChar(32)
  providerRef   String?       @db.VarChar(128)
  checkoutUrl   String?       @db.Text
  metadata      Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceId, createdAt])
  @@index([providerRef])
}
