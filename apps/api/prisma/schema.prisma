  HOTEL
  VIEWPOINT
  ACTIVITY
  RESTAURANT
  TRANSPORT
  FREE_TIME
  OTHER
}

enum LineItemKind {
  REQUIRED
  OPTIONAL
  UPGRADE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
