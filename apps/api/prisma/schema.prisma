}

enum InquiryStatus {
  NEW
  AGENCY_REVIEWING
  ITINERARY_DRAFT
  SENT_TO_TOURIST
  TOURIST_VIEWED
  REVISION_REQUESTED
  ACCEPTED
  DECLINED
