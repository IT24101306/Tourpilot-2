{
  "name": "tourpilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w @tourpilot/api\" \"npm run dev -w @tourpilot/web\"",
    "dev:api": "npm run dev -w @tourpilot/api",
    "dev:web": "npm run dev -w @tourpilot/web",
    "dev:mobile": "npm run start -w @tourpilot/mobile",
    "build": "npm run build -w @tourpilot/shared && npm run db:generate -w @tourpilot/api && npm run build -w @tourpilot/api && npm run build -w @tourpilot/web",
    "db:generate": "npm run db:generate -w @tourpilot/api",
    "db:migrate": "npm run db:migrate -w @tourpilot/api",
    "db:seed": "npm run db:seed -w @tourpilot/api",
    "db:seed:demo": "npm run db:seed:demo -w @tourpilot/api",
    "db:push": "npm run db:push -w @tourpilot/api",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
